# Subscription token for the Roll Call API, bought over x402 with `npm run agent -- subscribe`.
# The enclave holds a credential, not a Hedera key.
SECRET_ROLLCALL_API_KEY=

# Which protocols are watched. This is an exposure map: it says where the money is.
SECRET_ROLLCALL_WATCHLIST=[{"chain":"ethereum","safe":"0xBb4716A4A47342aAd4f162ebc34AF8414360Cdc5","minHonestQuorum":2,"maxDarkSigners":2}]

# The protection rules, in the challenge contract's integers (112 = health factor 1.12, 300 = 3.00 vETH).
# Where the position can be pushed, how much protection each action buys, which leg is spent first,
# and which governance readings force an unwind. None of this appears in config, logs or on chain.
SECRET_PROTECTION_RULES={"triggerHf":112,"targetHf":125,"criticalHf":102,"maxDepositUnits":300,"maxRepayPct":20,"preferDeposit":true,"cooldownBlocks":10,"minHonestQuorum":2,"maxDarkSigners":2}

# A dedicated Sepolia key for the challenge position. Fund it with a little Sepolia ETH for gas.
# `npm run challenge -- keygen` prints one.
SECRET_CHALLENGE_PRIVATE_KEY=
