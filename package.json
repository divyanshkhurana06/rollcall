{
  "name": "rollcall",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "probe": "tsx packages/core/test/probe-recovery.ts",
    "report": "tsx packages/core/src/cli.ts",
    "validate": "tsx packages/core/src/validate.ts",
    "api": "tsx apps/api/src/server.ts",
    "mcp": "tsx packages/mcp/src/server.ts",
    "web": "cd apps/web && vite",
    "scan": "tsx packages/core/src/scan.ts",
    "setup:hedera": "tsx scripts/setup-hedera.ts",
    "agent": "tsx packages/agent/src/pay.ts",
    "cover": "tsx packages/cover/src/issue.ts",
    "manifest": "tsx subgraph/generate-manifest.ts",
    "protect": "tsx cre/simulate.ts",
    "scan:protocols": "tsx packages/core/src/scan-protocols.ts",
    "challenge": "tsx cre/challenge.ts",
    "agent:subscribe": "tsx packages/agent/src/subscribe.ts",
    "tunnel": "cloudflared tunnel --url http://localhost:8787",
    "build:web": "vite build apps/web",
    "build:api": "esbuild apps/api/src/server.ts --bundle --packages=external --platform=node --format=esm --outfile=api/_server.mjs",
    "build": "npm run build:api && npm run build:web",
    "agent:register": "tsx scripts/register-agent.ts",
    "setup:hts": "tsx scripts/setup-hts.ts",
    "agent:schedule": "tsx packages/agent/src/schedule.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.125.0",
    "@chainlink/cre-sdk": "^1.19.1",
    "@hashgraph/asset-tokenization-sdk": "^8.0.0",
    "@hashgraph/sdk": "^2.81.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@vercel/functions": "^3.9.7",
    "@x402/hedera": "^2.25.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "viem": "^2.56.3",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@graphprotocol/graph-cli": "^0.98.1",
    "@graphprotocol/graph-ts": "^0.38.2",
    "@vitejs/plugin-react": "^6.1.1",
    "vite": "^8.2.2"
  }
}
